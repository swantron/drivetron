rules_version = '2';

// Rules are the only backend: the app is a static export with no server.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function family(fid) {
      return get(/databases/$(database)/documents/families/$(fid)).data;
    }

    function isMember(fid) {
      return signedIn() && request.auth.uid in family(fid).memberUids;
    }

    function validMember(m) {
      return m.keys().hasOnly(['name', 'initials', 'role'])
        && m.name is string && m.name.size() > 0 && m.name.size() <= 80
        && m.initials is string && m.initials.size() > 0 && m.initials.size() <= 4
        && m.role in ['supervisor', 'learner'];
    }

    function validFamily(f) {
      return f.keys().hasOnly(['learnerName', 'learnerDob', 'permitDate', 'ownerUid', 'memberUids', 'members',
                               'inviteCode', 'joinCode', 'lastLat', 'lastLng', 'createdAt'])
        && f.learnerName is string && f.learnerName.size() > 0 && f.learnerName.size() <= 80
        && f.learnerDob is string && f.learnerDob.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && f.permitDate is string && f.permitDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && f.memberUids is list && f.memberUids.size() <= 20
        && f.members is map
        && f.inviteCode is string && f.inviteCode.size() >= 8;
    }

    // Lookup from a shared code to its family. Readable one at a time by code, never listable,
    // so codes can't be enumerated.
    match /invites/{code} {
      allow get: if signedIn();
      allow create: if signedIn()
        && code.size() >= 8
        && request.resource.data.keys().hasOnly(['familyId'])
        && getAfter(/databases/$(database)/documents/families/$(request.resource.data.familyId)).data.ownerUid == request.auth.uid
        && getAfter(/databases/$(database)/documents/families/$(request.resource.data.familyId)).data.inviteCode == code;
      allow delete: if signedIn() && family(resource.data.familyId).ownerUid == request.auth.uid;
    }

    match /families/{fid} {
      allow read: if signedIn() && request.auth.uid in resource.data.memberUids;

      allow create: if signedIn()
        && validFamily(request.resource.data)
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.memberUids == [request.auth.uid]
        && request.resource.data.members.keys().hasOnly([request.auth.uid])
        && validMember(request.resource.data.members[request.auth.uid]);

      // Any member edits the learner details, their own member entry and the last location.
      // Only the owner changes who belongs or the invite code.
      allow update: if signedIn()
        && validFamily(request.resource.data)
        && request.resource.data.ownerUid == resource.data.ownerUid
        && (
          (request.auth.uid == resource.data.ownerUid)
          || (
            request.auth.uid in resource.data.memberUids
            && request.resource.data.memberUids == resource.data.memberUids
            && request.resource.data.inviteCode == resource.data.inviteCode
            && request.resource.data.members.diff(resource.data.members).affectedKeys().hasOnly([request.auth.uid])
          )
          || isJoining()
        )
        && (!(request.auth.uid in request.resource.data.members) || validMember(request.resource.data.members[request.auth.uid]));

      // Joining with the invite code: add only yourself, change nothing else.
      function isJoining() {
        return !(request.auth.uid in resource.data.memberUids)
          && request.resource.data.joinCode == resource.data.inviteCode
          && request.resource.data.memberUids == resource.data.memberUids.concat([request.auth.uid])
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids', 'members', 'joinCode'])
          && request.resource.data.members.diff(resource.data.members).affectedKeys().hasOnly([request.auth.uid]);
      }

      allow delete: if signedIn() && request.auth.uid == resource.data.ownerUid;

      match /drives/{did} {
        function validDrive(d) {
          return d.keys().hasOnly(['startedAt', 'endedAt', 'dayMinutes', 'nightMinutes', 'supervisorUid',
                                   'supervisorName', 'supervisorInitials', 'conditions', 'skills', 'notes',
                                   'lat', 'lng', 'manual', 'createdBy', 'updatedAt'])
            && d.startedAt is int
            && (d.endedAt == null || (d.endedAt is int && d.endedAt > d.startedAt))
            && d.dayMinutes is int && d.dayMinutes >= 0
            && d.nightMinutes is int && d.nightMinutes >= 0
            // A single entry over 16 hours is a forgotten timer, not a drive
            && d.dayMinutes + d.nightMinutes <= 960
            && d.supervisorUid is string
            && d.supervisorName is string && d.supervisorName.size() <= 80
            && d.supervisorInitials is string && d.supervisorInitials.size() <= 4
            && d.conditions is list && d.conditions.size() <= 30
            && d.skills is list && d.skills.size() <= 30
            && d.notes is string && d.notes.size() <= 2000
            && (d.lat == null || d.lat is number)
            && (d.lng == null || d.lng is number)
            && d.manual is bool
            && d.createdBy is string
            && d.updatedAt is int;
        }

        allow read, delete: if isMember(fid);
        allow create: if isMember(fid) && validDrive(request.resource.data)
          && request.resource.data.createdBy == request.auth.uid;
        allow update: if isMember(fid) && validDrive(request.resource.data)
          && request.resource.data.createdBy == resource.data.createdBy;
      }
    }
  }
}
