rules_version = '2';

// Rules are the only backend: the app is a static export with no server.
//
// Trust model
// - The owner (the parent who created the log) decides who belongs and what role they have.
//   Joining is a request the owner approves; nobody can add themselves.
// - Supervisors (licensed adults) can log, edit and delete any drive.
// - Learners can time their own drives from their own phone, but can't type in past drives,
//   can't change the times on a finished drive, and can't touch drives someone else logged.
//   The parent certifies these hours on MVD form 21-1600, so a learner must not be able to pad them.
// - Any change to a finished drive's times is permanently flagged (timesEdited) and shows on the log.
// - Times can't be in the future (judged by the server clock), a timer can't be relabelled as
//   typed-in or back, and a learner's timer records when the server first saw it (syncedAt), so a
//   drive that claims to have started long before it reached the server is marked on the log.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function familyPath(fid) {
      return /databases/$(database)/documents/families/$(fid);
    }

    function family(fid) {
      return get(familyPath(fid)).data;
    }

    function isMember(fid) {
      return signedIn() && request.auth.uid in family(fid).memberUids;
    }

    function roleIn(fid) {
      return family(fid).members[request.auth.uid].role;
    }

    function isSupervisor(fid) {
      return isMember(fid) && roleIn(fid) == 'supervisor';
    }

    function validMember(m) {
      return m.keys().hasOnly(['name', 'initials', 'role'])
        && m.name is string && m.name.size() > 0 && m.name.size() <= 80
        && m.initials is string && m.initials.size() > 0 && m.initials.size() <= 4
        && m.role in ['supervisor', 'learner'];
    }

    // Phones' clocks drift; allow a little slack before calling a time "in the future".
    function latestAllowedMs() {
      return request.time.toMillis() + 10 * 60 * 1000;
    }

    function isDate(v) {
      return v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function validFamily(f) {
      return f.keys().hasOnly(['learners', 'vehicles', 'learnerName', 'learnerDob', 'permitDate', 'ownerUid',
                               'memberUids', 'members', 'inviteCode', 'joinCode', 'approvedUid',
                               'lastLat', 'lastLng', 'createdAt'])
        // Legacy single-learner fields (pre-learners map)
        && (!('learnerName' in f) || (f.learnerName is string && f.learnerName.size() <= 80))
        && (!('learnerDob' in f) || isDate(f.learnerDob))
        && (!('permitDate' in f) || isDate(f.permitDate))
        // Map entries can't be iterated in rules; cap the sizes and validate shape client-side
        && (!('learners' in f) || (f.learners is map && f.learners.size() <= 6))
        && (!('vehicles' in f) || (f.vehicles is map && f.vehicles.size() <= 20))
        && f.memberUids is list && f.memberUids.size() <= 20
        && f.members is map
        && f.inviteCode is string && f.inviteCode.size() >= 8;
    }

    // Lookup from a shared code to its family. Readable one at a time by code, never listable,
    // so codes can't be enumerated (31^8 possibilities).
    match /invites/{code} {
      allow get: if signedIn();
      allow create: if signedIn()
        && code.size() >= 8
        && request.resource.data.keys().hasOnly(['familyId'])
        && getAfter(familyPath(request.resource.data.familyId)).data.ownerUid == request.auth.uid
        && getAfter(familyPath(request.resource.data.familyId)).data.inviteCode == code;
      allow delete: if signedIn() && family(resource.data.familyId).ownerUid == request.auth.uid;
    }

    match /families/{fid} {
      allow read: if signedIn() && request.auth.uid in resource.data.memberUids;

      allow create: if signedIn()
        && validFamily(request.resource.data)
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.memberUids == [request.auth.uid]
        && request.resource.data.members.keys().hasOnly([request.auth.uid])
        && validMember(request.resource.data.members[request.auth.uid])
        && request.resource.data.members[request.auth.uid].role == 'supervisor';

      function changed() {
        return request.resource.data.diff(resource.data).affectedKeys();
      }

      function addedUids() {
        return request.resource.data.memberUids.toSet().difference(resource.data.memberUids.toSet());
      }

      // Owner: manages membership. Someone can only be added through their own pending join
      // request (named in approvedUid), one at a time, so an owner can't push a family onto a
      // stranger's account.
      function ownerUpdate() {
        return request.auth.uid == resource.data.ownerUid
          && request.auth.uid in request.resource.data.memberUids
          && (
            addedUids().size() == 0
            || (
              addedUids().size() == 1
              && addedUids().hasOnly([request.resource.data.approvedUid])
              && exists(/databases/$(database)/documents/families/$(fid)/joinRequests/$(request.resource.data.approvedUid))
            )
          );
      }

      // Other members: vehicles, their own name/initials (not role), last location; supervisors also learner details.
      function memberUpdate() {
        return request.auth.uid in resource.data.memberUids
          && !changed().hasAny(['memberUids', 'inviteCode', 'ownerUid', 'approvedUid', 'joinCode'])
          && request.resource.data.members.diff(resource.data.members).affectedKeys().hasOnly([request.auth.uid])
          && request.resource.data.members[request.auth.uid].role == resource.data.members[request.auth.uid].role
          // The license date drives the 6-month hold; only adults edit learner details
          && (resource.data.members[request.auth.uid].role == 'supervisor'
              || !changed().hasAny(['learners', 'learnerName', 'learnerDob', 'permitDate']));
      }

      // A member (not the owner) leaving: removes only themselves.
      function leaving() {
        return request.auth.uid in resource.data.memberUids
          && request.auth.uid != resource.data.ownerUid
          && request.resource.data.memberUids.toSet() == resource.data.memberUids.toSet().difference([request.auth.uid].toSet())
          && changed().hasOnly(['memberUids', 'members'])
          && request.resource.data.members.diff(resource.data.members).affectedKeys().hasOnly([request.auth.uid])
          && !(request.auth.uid in request.resource.data.members);
      }

      // Owner hands the log to another supervising adult; nothing else changes in the same write.
      function transferring() {
        return request.auth.uid == resource.data.ownerUid
          && changed().hasOnly(['ownerUid'])
          && request.resource.data.ownerUid in resource.data.memberUids
          && resource.data.members[request.resource.data.ownerUid].role == 'supervisor';
      }

      allow update: if signedIn()
        && validFamily(request.resource.data)
        && (
          (request.resource.data.ownerUid == resource.data.ownerUid && (ownerUpdate() || memberUpdate() || leaving()))
          || transferring()
        )
        && (!(request.auth.uid in request.resource.data.members) || validMember(request.resource.data.members[request.auth.uid]));

      allow delete: if signedIn() && request.auth.uid == resource.data.ownerUid;

      // Someone with the invite code asking to join. They can't read the family until the owner
      // approves, so the doc id is their uid and they read only their own request.
      match /joinRequests/{uid} {
        allow get: if signedIn() && (request.auth.uid == uid || isMember(fid));
        allow list: if isMember(fid);
        allow create, update: if signedIn()
          && request.auth.uid == uid
          && !(uid in family(fid).memberUids)
          && request.resource.data.keys().hasOnly(['name', 'initials', 'role', 'code', 'createdAt', 'email'])
          // The owner sees the Google account's address, not just a typed name
          && request.resource.data.get('email', null) == request.auth.token.get('email', null)
          && request.resource.data.code == family(fid).inviteCode
          && validMember({
               'name': request.resource.data.name,
               'initials': request.resource.data.initials,
               'role': request.resource.data.role
             })
          && request.resource.data.createdAt is int;
        allow delete: if signedIn() && (request.auth.uid == uid || family(fid).ownerUid == request.auth.uid);
      }

      match /drives/{did} {
        function validDrive(d) {
          return d.keys().hasOnly(['learnerId', 'vehicleId', 'vehicleName', 'startedAt', 'endedAt', 'dayMinutes',
                                   'nightMinutes', 'supervisorUid', 'supervisorName', 'supervisorInitials',
                                   'conditions', 'skills', 'notes', 'lat', 'lng', 'manual', 'timesEdited',
                                   'createdBy', 'updatedAt', 'syncedAt'])
            && d.startedAt is int
            && d.startedAt <= latestAllowedMs()
            && (d.endedAt == null || d.endedAt <= latestAllowedMs())
            && (d.endedAt == null || (d.endedAt is int && d.endedAt > d.startedAt))
            && d.dayMinutes is int && d.dayMinutes >= 0
            && d.nightMinutes is int && d.nightMinutes >= 0
            // A single entry over 16 hours is a forgotten timer, not a drive
            && d.dayMinutes + d.nightMinutes <= 960
            && (d.endedAt == null || d.dayMinutes + d.nightMinutes <= (d.endedAt - d.startedAt) / 60000 + 1)
            && d.supervisorUid is string
            && d.supervisorName is string && d.supervisorName.size() <= 80
            && d.supervisorInitials is string && d.supervisorInitials.size() <= 4
            && d.conditions is list && d.conditions.size() <= 30
            && d.skills is list && d.skills.size() <= 30
            && d.notes is string && d.notes.size() <= 2000
            && (d.lat == null || d.lat is number)
            && (d.lng == null || d.lng is number)
            && d.manual is bool
            && (!('timesEdited' in d) || d.timesEdited is bool)
            && d.createdBy is string
            && d.updatedAt is int
            && (!('learnerId' in d) || (d.learnerId is string && d.learnerId.size() <= 40))
            && (!('vehicleId' in d) || d.vehicleId == null || (d.vehicleId is string && d.vehicleId.size() <= 40))
            && (!('vehicleName' in d) || d.vehicleName == null || (d.vehicleName is string && d.vehicleName.size() <= 80));
        }

        // The named supervisor is a current supervising adult, under their current name and the
        // initials the printed log shows.
        function validSupervisor(d) {
          return d.supervisorUid in family(fid).memberUids
            && family(fid).members[d.supervisorUid].role == 'supervisor'
            && d.supervisorName == family(fid).members[d.supervisorUid].name
            && d.supervisorInitials == family(fid).members[d.supervisorUid].initials;
        }

        function supervisorChanged() {
          return request.resource.data.supervisorUid != resource.data.supervisorUid
            || request.resource.data.supervisorName != resource.data.supervisorName
            || request.resource.data.supervisorInitials != resource.data.supervisorInitials;
        }

        function wasFinished() {
          return resource.data.endedAt != null;
        }

        function timesChanged() {
          return request.resource.data.startedAt != resource.data.startedAt
            || request.resource.data.endedAt != resource.data.endedAt
            || request.resource.data.dayMinutes != resource.data.dayMinutes
            || request.resource.data.nightMinutes != resource.data.nightMinutes;
        }

        // Once flagged, always flagged; and any change to a finished drive's times sets the flag.
        function auditOk() {
          return (!resource.data.get('timesEdited', false) || request.resource.data.get('timesEdited', false) == true)
            && (!wasFinished() || !timesChanged() || request.resource.data.get('timesEdited', false) == true);
        }

        allow read: if isMember(fid);

        allow create: if isMember(fid)
          && validDrive(request.resource.data)
          && validSupervisor(request.resource.data)
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.get('timesEdited', false) == false
          // A timer starts running; anything created already finished is a typed-in drive and says so
          && request.resource.data.manual == (request.resource.data.endedAt != null)
          // When present, syncedAt is the server's receipt time (serverTimestamp())
          && (!('syncedAt' in request.resource.data) || request.resource.data.syncedAt == request.time)
          // Learners can only start a live timer, not type in a past drive, and it must carry syncedAt
          && (isSupervisor(fid) || (request.resource.data.endedAt == null && 'syncedAt' in request.resource.data));

        allow update: if isMember(fid)
          && validDrive(request.resource.data)
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.manual == resource.data.manual
          && request.resource.data.get('syncedAt', null) == resource.data.get('syncedAt', null)
          && (!supervisorChanged() || validSupervisor(request.resource.data))
          && auditOk()
          && (
            isSupervisor(fid)
            || (
              // Learner: their own drive, or stopping any running timer (stopping early can only
              // reduce hours); once a drive is finished its times are fixed
              (resource.data.createdBy == request.auth.uid || !wasFinished())
              && request.resource.data.startedAt == resource.data.startedAt
              && (!wasFinished() || !timesChanged())
            )
          );

        allow delete: if isSupervisor(fid)
          // A learner can discard their own timer while it's still running (a mis-tap)
          || (isMember(fid) && resource.data.createdBy == request.auth.uid && resource.data.endedAt == null);
      }
    }
  }
}
